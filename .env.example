[TEMPLATE]
# Server port used by the execution and AI API
PORT=8787
# Set to true only after Docker Desktop is installed and running.
EXECUTION_ENABLED=false
# Docker images must be built from infrastructure/images before enabling execution.
PYTHON_IMAGE=compiler-companion-python:latest
CPP_IMAGE=compiler-companion-cpp:latest
# AI Provider - choose one:
# 
# Option 1: Groq (FREE, fastest ~1s responses)
#   1. Sign up at https://console.groq.com (no credit card needed)
#   2. Create API key at https://console.groq.com/keys
#   3. Set below:
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_key_here
AI_MODEL=llama-3.1-8b-instant
#
# Option 2: OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-key
# AI_MODEL=gpt-4o-mini
#
# Option 3: Local Ollama (free but slow on CPU)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.2
# Required in any shared environment; use a long random value.
AUTH_SECRET=replace-with-a-long-random-secret
